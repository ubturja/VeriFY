# VeriFY local configuration.
# Copy this file to .env and fill in values. Never commit .env.
# All secrets are read from the environment or a secret store. None are hardcoded.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
VERIFY_ENV=local
VERIFY_LOG_LEVEL=INFO
VERIFY_API_HOST=0.0.0.0
VERIFY_API_PORT=8000
VERIFY_CORS_ORIGINS=http://localhost:5173

# Participant inbox. Default assumes this repo lives at Dev/VeriFY
# next to the unzipped hackathon bundle.
VERIFY_DATA_DIR=../../sdoc-hackathon-bundle

# Optional: local ground truth for self-scoring. Do not commit this file.
# VERIFY_GROUND_TRUTH=../../sdoc-hackathon-docker/data_v2/ground_truth.json

# Optional: hackathon inbox HTTP server (docker compose in the organizer kit).
# VERIFY_INBOX_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database (local docker compose)
# ---------------------------------------------------------------------------
VERIFY_DATABASE_URL=postgresql+asyncpg://verify:verify@localhost:5432/verify

# ---------------------------------------------------------------------------
# Object storage
# Azure Blob in cloud; Azurite locally. Leave empty to use the local filesystem.
# ---------------------------------------------------------------------------
VERIFY_BLOB_BACKEND=local
VERIFY_LOCAL_BLOB_DIR=./artifacts/blob
# VERIFY_AZURE_STORAGE_CONNECTION_STRING=
# VERIFY_AZURE_BLOB_CONTAINER=verify-docs

# ---------------------------------------------------------------------------
# Queue
# inmemory for laptop runs; servicebus when Azure is wired.
# ---------------------------------------------------------------------------
VERIFY_QUEUE_BACKEND=inmemory
# VERIFY_SERVICEBUS_CONNECTION_STRING=
# VERIFY_QUEUE_INGEST=ingest
# VERIFY_QUEUE_PROCESS=process
# VERIFY_QUEUE_REVIEW=review

# ---------------------------------------------------------------------------
# LLM providers
# Put keys here locally. In Azure they come from Key Vault.
# Free-tier Gemini is the primary model. Groq is the fallback.
# ---------------------------------------------------------------------------
VERIFY_LLM_PRIMARY=gemini
VERIFY_LLM_FALLBACK=groq
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---------------------------------------------------------------------------
# OCR
# tesseract runs locally with no cloud call. docintel is Azure F0 when configured.
# ---------------------------------------------------------------------------
VERIFY_OCR_BACKEND=tesseract
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ---------------------------------------------------------------------------
# Mail sources
# ---------------------------------------------------------------------------
VERIFY_MAIL_SOURCE=hackathon
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Optional bootstrap mailbox. Leave IMAP_USERNAME and IMAP_APP_PASSWORD blank
# to require every reviewer to sign in through the console. When both are set,
# the API registers this mailbox on startup so a deployed demo already has one.
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=30
VERIFY_IMAP_AUTOPOLL=true

# ---------------------------------------------------------------------------
# Auth (console)
# session = console requires a signed-in mailbox (Gmail address + app password).
# Set VERIFY_SECRET_KEY to a Fernet key (Fernet.generate_key()) in production.
# When it is empty in local/test, a key is minted and cached at
# artifacts/tenants/.secret_key so restarts stay signed in.
# ---------------------------------------------------------------------------
VERIFY_AUTH_MODE=session
VERIFY_SECRET_KEY=
VERIFY_TENANTS_DIR=./artifacts/tenants
VERIFY_REVIEWER_NAME=Reviewer
VERIFY_STATE_PATH=./artifacts/state.json
# SQLite is used when the path ends in .sqlite / .db. JSON is the default.
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=

# ---------------------------------------------------------------------------
# Azure (Terraform mapping for Averis production). Not required for the
# Render demo. Leave empty until a subscription with credits exists.
# ---------------------------------------------------------------------------
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=
# VERIFY_AZURE_LOCATION=southeastasia
# VERIFY_RESOURCE_GROUP=rg-verify-dev
